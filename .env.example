# ClipCraft AI configuration — copy this file to .env and fill in what you use.
# Everything here is read on the server only and never sent to the browser.
# Restart `npm run dev` after editing.

# --- Database (required) ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=clipcraft

# --- LLM: analysis, segment labels, visual prompts, titles, thumbnail headlines ---
# groq | openai | gemini | claude | glm | ollama
LLM_PROVIDER=groq
# Groq: openai/gpt-oss-120b (best, tested on Hinglish) | qwen/qwen3.8-27b | openai/gpt-oss-20b
# leave empty for the provider's default model
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
# only used when LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434

# --- Transcription ---
# local (faster-whisper on this machine) | groq | openai
# groq is the fastest and most accurate for Hinglish
TRANSCRIPTION_ENGINE=groq
# groq engine: whisper-large-v3-turbo (Roman-script Hinglish, fast) | whisper-large-v3
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# local engine: tiny | base | small | medium | large-v3 (Hindi/Hinglish always uses at least "small")
WHISPER_MODEL=small

# --- API keys (all optional except the one for your LLM_PROVIDER / TRANSCRIPTION_ENGINE) ---
# free at console.groq.com — covers both the LLM and transcription above
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
# stock video b-roll (free at pexels.com/api); without it, free image search is used
PEXELS_API_KEY=
# backup stock provider (free at pixabay.com/api/docs)
PIXABAY_API_KEY=
HUGGINGFACE_API_KEY=

# --- Rendering ---
# auto (NVIDIA NVENC -> Intel Quick Sync -> CPU) | nvenc | qsv | cpu
# a GPU step that fails is retried on the CPU automatically
VIDEO_ENCODER=auto

# --- Misc ---
# force a python binary, e.g. .venv/Scripts/python.exe (Windows) or .venv/bin/python
PYTHON_BIN=
# set to 1 to log how long each ffmpeg step takes
CC_PROFILE=
